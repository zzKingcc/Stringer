<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zzkingcc</groupId>
        <artifactId>Stringer</artifactId>
        <version>v1.0-beta.1</version>
    </parent>

    <artifactId>stringer-agent-client</artifactId>
    <name>stringer-agent-client</name>
    <description>Stringer 对话 SDK（消费侧）：远程调用 chat / resume / stop 与知识库，提供域门面与启动期连通性校验；
        编排 / 知识库 / 存储逻辑仍在服务端。工具注册能力在独立的 stringer-tool-provider 中</description>

    <dependencies>
        <!-- ===== 公共契约层：契约 + 公共异常 + 服务端连接配置 ===== -->
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>stringer-sdk-core</artifactId>
        </dependency>

        <!-- ===== Spring Boot 装配 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 响应式 WebClient：客户端用 SSE 流式调用服务端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Jackson：客户端要解析服务端的错误报文（把 {code,...} 还原成带码异常，
             见 StringerErrors），属直接使用，显式声明而不依赖传递依赖 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok 只在编译期生成代码，provided 不进交付物 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
